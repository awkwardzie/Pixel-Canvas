import pygame
import sys

# Canvas Selection Before Pygame Starts
print("Choose your canvas size:")
print("1 = Square")
print("2 = Landscape")
print("3 = Portrait")

choice = input("Enter your choice (1, 2, or 3): ")

if choice == "1":
    WIDTH = 600
    HEIGHT = 600
    canvas_type = "Square"

elif choice == "2":
    WIDTH = 800
    HEIGHT = 500
    canvas_type = "Landscape"

elif choice == "3":
    WIDTH = 500
    HEIGHT = 800
    canvas_type = "Portrait"

else:
    print("Invalid choice. Defaulting to Square canvas.")
    WIDTH = 600
    HEIGHT = 600
    canvas_type = "Square"

# Initialize Pygame
pygame.init()

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption(f"Pixel Canvas - {canvas_type}")

# Background color
WHITE = (255, 255, 255)
screen.fill(WHITE)

# Main Game Loop
running = True

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    pygame.display.update()

# Close Program
pygame.quit()
sys.exit()