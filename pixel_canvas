import pygame
import sys

# Canvas Selection Before Pygame Starts
print("Choose your canvas size:")
print("1 = Square")
print("2 = Landscape")
print("3 = Portrait")

choice = input("Enter your choice (1, 2, or 3): ")

if choice == "1":
    WIDTH = 600
    HEIGHT = 600
    canvas_type = "Square"

elif choice == "2":
    WIDTH = 800
    HEIGHT = 500
    canvas_type = "Landscape"

elif choice == "3":
    WIDTH = 500
    HEIGHT = 800
    canvas_type = "Portrait"

else:
    print("Invalid choice. Defaulting to Square canvas.")
    WIDTH = 600
    HEIGHT = 600
    canvas_type = "Square"

# Grid Settings
# Start with preferred size
PREFERRED_PIXEL_SIZE = 60

# Adjust pixel size so grid fits perfectly
PIXEL_SIZE = min(
    WIDTH // (WIDTH // PREFERRED_PIXEL_SIZE),
    HEIGHT // (HEIGHT // PREFERRED_PIXEL_SIZE)
)

# Safety check if window is smaller than preferred size
if PIXEL_SIZE <= 0:
    PIXEL_SIZE = 60

# Number of rows and columns
ROWS = HEIGHT // PIXEL_SIZE
COLS = WIDTH // PIXEL_SIZE

# Initialize Pygame
pygame.init()

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption(f"Pixel Canvas - {canvas_type}")

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
RED = (255, 0, 0)
ORANGE = (255, 165, 0)
YELLOW = (255, 255, 0)
GREEN = (0, 255, 0)
BLUE = (0, 0, 255)
PURPLE = (128, 0, 128)
PINK = (255, 105, 180)
BROWN = (139, 69, 19)
GRAY = (120, 120, 120)

# Click cycle order
COLOR_CYCLE = [
    BLACK,   # Starting color
    WHITE,   # 1 click
    RED,     # 2 clicks
    ORANGE,  # 3 clicks
    YELLOW,  # 4 clicks
    GREEN,   # 5 clicks
    BLUE,    # 6 clicks
    PURPLE,  # 7 clicks
    PINK,    # 8 clicks
    BROWN    # 9 clicks
]

# Grid Data Storage
# Store the color of each square
grid = []

for row in range(ROWS):
    grid_row = []
    for col in range(COLS):
        grid_row.append(BLACK)  # Start all squares as black
    grid.append(grid_row)

# Function to Draw Grid
def draw_grid():
    for row in range(ROWS):
        for col in range(COLS):
            x = col * PIXEL_SIZE
            y = row * PIXEL_SIZE

            rect = pygame.Rect(x, y, PIXEL_SIZE, PIXEL_SIZE)

            # Fill with saved color
            pygame.draw.rect(screen, grid[row][col], rect)

            # Draw border
            pygame.draw.rect(screen, GRAY, rect, 2)

# Function to Cycle Colors
def cycle_color(current_color):
    current_index = COLOR_CYCLE.index(current_color)

    # Move to next color
    next_index = (current_index + 1) % len(COLOR_CYCLE)

    return COLOR_CYCLE[next_index]

# Function to Draw Grid
def draw_grid():
    for x in range(0, WIDTH, PIXEL_SIZE):
        for y in range(0, HEIGHT, PIXEL_SIZE):
            rect = pygame.Rect(x, y, PIXEL_SIZE, PIXEL_SIZE)
            pygame.draw.rect(screen, BLACK, rect)   # Fill square
            pygame.draw.rect(screen, GRAY, rect, 2) # Gray border

# Main Game Loop
running = True

while running:
    for event in pygame.event.get():

        # Close window using X button
        if event.type == pygame.QUIT:
            running = False

        # Press ESC key to close window
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False

        # Mouse click cycles through colors
        if event.type == pygame.MOUSEBUTTONDOWN:
            mouse_x, mouse_y = pygame.mouse.get_pos()

            col = mouse_x // PIXEL_SIZE
            row = mouse_y // PIXEL_SIZE

            if row < ROWS and col < COLS:
                current_color = grid[row][col]
                grid[row][col] = cycle_color(current_color)


  # Background Color
    screen.fill(BLACK)
    draw_grid()
    pygame.display.update()

# Close Program
pygame.quit()
sys.exit()